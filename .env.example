# data-mine API keys. Copy this file to .env and fill in the tools you plan to use.
# Each tool checks only its own keys and names any that are blank.

# tools/phone_validate.py : RealPhoneValidation DNC Plus token
REALVALIDATION_TOKEN=
# tools/phone_validate.py : Twilio Lookup caller name
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# tools/trestle_cnam.py : Trestle Smart CNAM
TRESTLE_API_KEY=

# tools/enformion_enrich.py : Enformion Contact Enrich Plus (Access Profile name and password)
ENFORMION_AP_NAME=
ENFORMION_AP_PASSWORD=

# tools/hunter_find.py : Hunter.io Email Finder
HUNTER_API_KEY=

# tools/emailable_verify.py : Emailable (live_... spends credits, test_... does not)
EMAILABLE_API_KEY=

# tools/middesk.py : Middesk (mk_live_... for real searches; mk_test_... only with --sandbox)
MIDDESK_API_KEY=

# Supabase: required for --table on any tool, and for phone_validate's optional cache.
# SUPABASE_ACCESS_TOKEN is a personal access token (Supabase dashboard > Account > Access Tokens).
# SUPABASE_PROJECT_REF is the project id in the dashboard URL: supabase.com/dashboard/project/<project ref>
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
